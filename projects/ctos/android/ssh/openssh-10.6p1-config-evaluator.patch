+/* Finite AUDIT policy, after the shared lexer and before first-value/Host
+ * semantics. Reuse the pinned opcode and multistate tables; this is not an
+ * Options evaluator or a complete value validator for other directives. */
+static int
+audit_config_policy(OpCodes opcode, int ac, char **av, const char *raw,
+    const char *filename, int linenum)
+{
+	const struct multistate *table = multistate_flag;
+	unsigned int reason = CTOS_CONFIG_EXTERNAL;
+	int value, allowed = 0;
+	switch (opcode) {
+	case oBadOption:
+	case oIgnoredUnknownOption:
+		return ctos_config_reject(CTOS_CONFIG_INPUT, EINVAL);
+	case oUnsupported:
+		return ctos_config_reject(CTOS_CONFIG_UNSUPPORTED, ENOTSUP);
+	case oIgnore:
+	case oDeprecated:
+		return 0;
+	case oMatch:
+		if (match_cfg_line(NULL, NULL, &ac, &av, NULL, NULL, NULL,
+		    NULL, 0, NULL, filename, linenum) < 0 || ac != 0)
+			return ctos_config_reject(CTOS_CONFIG_INPUT, EINVAL);
+		return 0;
+	case oProxyCommand:
+	case oLocalCommand:
+	case oKnownHostsCommand:
+		if (raw != NULL && strcasecmp(raw, "none") == 0)
+			return 0;
+		return ctos_config_reject(CTOS_CONFIG_COMMAND, EACCES);
+	case oIdentityAgent:
+	case oPKCS11Provider:
+	case oSecurityKeyProvider:
+	case oControlPath:
+		if (ac != 1 || *av[0] == '\0')
+			return ctos_config_reject(CTOS_CONFIG_INPUT, EINVAL);
+		if (strcasecmp(av[0], "none") == 0)
+			return 0;
+		return ctos_config_reject(CTOS_CONFIG_EXTERNAL, EACCES);
+	case oControlPersist:
+		if (ac != 1 || *av[0] == '\0')
+			return ctos_config_reject(CTOS_CONFIG_INPUT, EINVAL);
+		if (strcmp(av[0], "no") == 0 || strcmp(av[0], "false") == 0)
+			return 0;
+		return ctos_config_reject(CTOS_CONFIG_EXTERNAL, EACCES);
+	case oCanonicalizePermittedCNAMEs:
+		if (ac == 1 && strcasecmp(av[0], "none") == 0)
+			return 0;
+		return ctos_config_reject(CTOS_CONFIG_UNSUPPORTED, ENOTSUP);
+	case oCanonicalizeHostname:
+		table = multistate_canonicalizehostname;
+		reason = CTOS_CONFIG_UNSUPPORTED;
+		allowed = SSH_CANONICALISE_NO;
+		break;
+	case oStrictHostKeyChecking:
+		table = multistate_strict_hostkey;
+		reason = CTOS_CONFIG_TRUST;
+		break;
+	case oVerifyHostKeyDNS:
+		table = multistate_yesnoask;
+		reason = CTOS_CONFIG_TRUST;
+		break;
+	case oNoHostAuthenticationForLocalhost:
+		reason = CTOS_CONFIG_TRUST;
+		break;
+	case oAddKeysToAgent:
+		if (ac == 0 || *av[0] == '\0')
+			return ctos_config_reject(CTOS_CONFIG_INPUT, EINVAL);
+		if (ac == 1 && parse_multistate_value(av[0], filename, linenum,
+		    multistate_yesnoaskconfirm) == 0)
+			return 0;
+		/* Enabled duration/confirm forms are rejected without interpreting
+		 * their context or rebuilding the original time grammar. */
+		return ctos_config_reject(CTOS_CONFIG_EXTERNAL, EACCES);
+	case oControlMaster:
+		table = multistate_controlmaster;
+		allowed = SSHCTL_MASTER_NO;
+		break;
+	case oTunnel:
+		table = multistate_tunnel;
+		allowed = SSH_TUNMODE_NO;
+		break;
+	case oForwardAgent:
+	case oForwardX11:
+	case oForwardX11Trusted:
+	case oHostbasedAuthentication:
+	case oEnableSSHKeysign:
+	case oGssAuthentication:
+	case oGssDelegateCreds:
+	case oForkAfterAuthentication:
+	case oEnableEscapeCommandline:
+	case oPermitLocalCommand:
+	case oProxyUseFdpass:
+		break;
+	default:
+		return 0;
+	}
+	if (ac != 1 || *av[0] == '\0')
+		return ctos_config_reject(CTOS_CONFIG_INPUT, EINVAL);
+	value = parse_multistate_value(av[0], filename, linenum, table);
+	if (value == -1 && opcode != oForwardAgent)
+		return ctos_config_reject(CTOS_CONFIG_INPUT, EINVAL);
+	if (opcode == oStrictHostKeyChecking ?
+	    (value == SSH_STRICT_HOSTKEY_YES || value == SSH_STRICT_HOSTKEY_ASK) : value == allowed)
+		return 0;
+	return ctos_config_reject(reason, reason == CTOS_CONFIG_UNSUPPORTED ? ENOTSUP : EACCES);
+}
