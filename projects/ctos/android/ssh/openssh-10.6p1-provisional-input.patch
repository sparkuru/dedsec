+
+/* Non-dispatching, non-writing parser for an unauthenticated provisional
+ * child. The caller owns the session and validates/discards EXT_INFO. */
+__attribute__((visibility("hidden"))) int
+ctos_ssh_packet_read_provisional(struct ssh *ssh, u_char *typep)
+{
+	int r;
+
+	if (ssh == NULL || ssh->state == NULL || typep == NULL)
+		return SSH_ERR_INVALID_ARGUMENT;
+	*typep = SSH_MSG_NONE;
+	r = ssh_packet_read_poll2_internal(ssh, typep, NULL, 1);
+	if (r != 0)
+		*typep = SSH_MSG_NONE;
+	return r;
+}
