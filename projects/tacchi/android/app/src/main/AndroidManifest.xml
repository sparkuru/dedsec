<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries>
        <package android:name="dev.tacchi.probe" />
    </queries>
    <application
        android:name=".TacchiApplication"
        android:label="tacchi"
        android:description="@string/module_description"
        android:icon="@drawable/ic_tacchi"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name=".ipc.ProbeProvider"
            android:authorities="im.majo.tacchi.probe"
            android:exported="true" />
    </application>
</manifest>
